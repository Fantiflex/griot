# ---------- Serveur ----------
PORT=3000
# Dossier des données (SQLite, cache audio)
DATA_DIR=data

# ---------- Modèle de langue (API compatible OpenAI) ----------
# Développement sur PC : Ollama.   ollama pull gemma3:4b
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=gemma3:4b
# Modèle utilisé pour lire les images d'ardoise (Gemma 3 est multimodal, même modèle par défaut)
LLM_VISION_MODEL=gemma3:4b
LLM_TIMEOUT_MS=90000
LLM_TEMPERATURE=0.6

# Démo GPU loué avec vLLM et l'adaptateur LoRA LeGriot (voir finetune/README.md) :
# LLM_BASE_URL=http://vllm:8000/v1
# LLM_MODEL=legriot-griot-fr-sw

# Sans modèle du tout (tests) :  npm run mock:llm  puis
# LLM_BASE_URL=http://localhost:11435/v1

# ---------- Lecture du manuscrit ----------
# Mathpix (optionnel, payant). Sans clé, le modèle de vision auto-hébergé lit l'ardoise.
MATHPIX_APP_ID=
MATHPIX_APP_KEY=

# ---------- Voix du Griot ----------
# Sidecar Piper (services/tts). Sans lui, la voix du navigateur prend le relais.
TTS_URL=http://localhost:5002
TTS_ENABLED=true

# ---------- HTTPS local (caméra du téléphone sur le réseau local) ----------
# npm run cert:dev
# SSL_CERT=certs/dev-cert.pem
# SSL_KEY=certs/dev-key.pem
